<UXML xmlns="UnityEngine.UIElements" xmlns:weft="Weft.Unity.Engine" editor-extension-mode="False">
    <Style src="DemoScene.uss"/>
    <VisualElement name="Root">
        <VisualElement name="Header">
            <Label name="Title" text="Weft Demo"/>
            <DropdownField name="ExampleDropdown" label="Examples"/>
        </VisualElement>
        <VisualElement name="MainContent">
            <VisualElement name="EditorArea">
                <ScrollView name="ScriptScroll">
                    <weft:ScriptEditor/>
                </ScrollView>
            </VisualElement>
            <VisualElement name="ScriptButtonContainer">
                <Button name="RunButton" text="Run"/>
                <Button name="PauseButton" text="Stop"/>
            </VisualElement>
            <VisualElement name="ConsoleContainer">
                <Label name="ConsoleHeader" text="Console"/>
                <ScrollView name="ConsoleScroll">
                    <Label name="Output" enable-rich-text="true"/>
                </ScrollView>
            </VisualElement>
        </VisualElement>
    </VisualElement>
</UXML>
